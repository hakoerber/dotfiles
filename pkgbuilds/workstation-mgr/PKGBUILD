# Maintainer: Hannes Körber <hannes@hkoerber.de>
pkgname='workstation-mgr'
pkgver=19
pkgrel=1
pkgdesc=''
arch=('x86_64')
depends=('glibc' 'gcc-libs')
makedepends=('cargo')
options=(!lto)
source=()
sha256sums=()
_builddir="../../../mgr"

# pkgver() {
#   cd "/var/lib/dotfiles/mgr/"
#   git log --oneline . | wc -l
# }

prepare() {
  cd "${_builddir}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${_builddir}"
  export RUSTUP_TOOLCHAIN=stable
  # export CARGO_TARGET_DIR=/var/lib/makepkg/${pkgname}/build/target
  cargo build --frozen --release
}

check() {
  :
  # cd "${_builddir}"
  # export RUSTUP_TOOLCHAIN=stable
  # cargo test --frozen
}

package() {
  # cd "${_builddir}"
  # export CARGO_TARGET_DIR=/var/lib/makepkg/${pkgname}/build/target
  install -Dm0755 -t "$pkgdir/usr/bin/" "${_builddir}/target/release/${pkgname}"
  install -Dm0755 -t "$pkgdir/usr/bin/" "${_builddir}/target/release/workstation-client"
}
